<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Checkstyle — Hort-Sistema
    Focus on semantic issues that Spotless doesn't address.
    Formatting (indentation, spacing, line length) is Spotless' responsibility.
    
    DTD source: https://checkstyle.org/dtds/configuration_1_3.dtd
-->
<module name="Checker">
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <!-- Files must end with newline -->
    <module name="NewlineAtEndOfFile"/>

    <!-- No trailing whitespace -->
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Line has trailing whitespace."/>
    </module>

    <!-- TreeWalker for semantic checks -->
    <module name="TreeWalker">

        <!-- No wildcard imports -->
        <module name="AvoidStarImport"/>

        <!-- No unused imports -->
        <module name="UnusedImports"/>

        <!-- No redundant modifiers -->
        <module name="RedundantModifier"/>

    </module>

</module>
