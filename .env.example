# Hort-Sistema — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores

# JWT Secret — deve ter pelo menos 256 bits (32 caracteres)
# Gere um com: openssl rand -hex 32
JWT_SECRET=substitua-por-uma-chave-segura-de-pelo-menos-256-bits-aqui

# Origens CORS permitidas (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
