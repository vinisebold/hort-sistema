#!/usr/bin/env bash
# pre-commit hook: verifica formatação e estilo antes de cada commit
set -euo pipefail

echo "🔍 [pre-commit] Verificando formatação (Spotless)..."
mvn --no-transfer-progress spotless:check -q

echo "🔍 [pre-commit] Verificando estilo (Checkstyle)..."
mvn --no-transfer-progress checkstyle:check -q

echo "✅ [pre-commit] Verificações passaram."
